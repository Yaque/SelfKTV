<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@string/listen_detail_back_desc"
        android:src="@drawable/ic_back"
        app:tint="@color/text_dark" />

    <!-- 封面 / 歌名 / 歌手 -->
    <ImageView
        android:id="@+id/ivCover"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/listen_detail_cover_desc"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_cover_placeholder" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="24dp"
        android:text="@string/listen_detail_default_title"
        android:textColor="@color/text_dark"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvArtist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="24dp"
        android:text="@string/listen_unknown_artist"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- 音轨选择 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/listen_track_label"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipOriginal"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_toggle"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/listen_track_original"
            android:textColor="@color/listen_chip_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipVocal"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_toggle"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/listen_track_vocal"
            android:textColor="@color/listen_chip_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipAccomp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_toggle"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/listen_track_accomp"
            android:textColor="@color/listen_chip_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 操作行：收藏 / 歌单管理 / 播放模式 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/tvFav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/listen_fav"
            android:padding="6dp"
            android:text="♡"
            android:textColor="@color/text_muted"
            android:textSize="24sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnPlaylist"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_button_outline"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/listen_playlist_join"
            android:textColor="@color/brand_green"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnMode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_outline"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/listen_mode_list_loop"
            android:textColor="@color/brand_green"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 歌词（LRC 滚动 / 纯文本静态） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp">

        <com.aiocw.selfktv.ui.widget.LyricView
            android:id="@+id/lyricView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card" />

        <ScrollView
            android:id="@+id/scrollPlain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card"
            android:fillViewport="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPlainLyric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:padding="18dp"
                android:text="@string/listen_lyric_loading"
                android:textColor="@color/text_dark"
                android:textSize="15sp" />
        </ScrollView>
    </FrameLayout>

    <!-- 播放控件 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/brand_green"
            android:thumbTint="@color/brand_green" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTimeCur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/listen_time_zero"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTimeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/listen_time_zero"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="2dp">

            <TextView
                android:id="@+id/tvPrev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/listen_ctrl_prev"
                android:textColor="@color/text_dark"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:padding="4dp"
                android:text="@string/listen_ctrl_play"
                android:textColor="@color/brand_green_dark"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/tvNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/listen_ctrl_next"
                android:textColor="@color/text_dark"
                android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
